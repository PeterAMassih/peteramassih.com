---
// src/pages/stack.astro
// Falling-tetromino game with synthesized Korobeiniki audio.
// Game logic in src/scripts/stack.js; this file is markup + scoped styling.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Falling blocks — Peter Massih" description="Falling blocks, one of the toys on Peter Massih's site.">
  <main id="main">
    <h1>Falling blocks</h1>

    <canvas id="stack-canvas" class="canvas" role="img" aria-label="Falling tetromino playfield" width="300" height="600"></canvas>

    <p class="meta">
      score <span id="score">0</span> · global high <span id="high">0</span> · lines <span id="lines">0</span> · level <span id="level">1</span>
    </p>

    <div class="controls">
      <button id="toggle" type="button">pause</button>
      <button id="restart" type="button">restart</button>
      <button id="sound" type="button" aria-pressed="false">sound: off</button>
    </div>

    <p class="hint hint-keyboard">← → move · ↑ rotate · ↓ soft drop · space hard drop · p pause</p>
    <p class="hint hint-touch">drag ← → move · tap rotate · drag ↓ soft drop · swipe ↑ hard drop</p>
  </main>
</BaseLayout>

<script>import '../scripts/stack.js';</script>

<style>
  .canvas {
    width: 100%;
    max-width: 300px;
    aspect-ratio: 1 / 2;
    margin-bottom: var(--space-4);
    background: var(--color-code-bg);
    border-radius: 4px;
    image-rendering: pixelated;
    /* Stop the browser from claiming swipes (scroll, back-nav, pull-to-refresh). */
    touch-action: none;
  }
  .meta {
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    letter-spacing: 0.02em;
  }
  .controls {
    margin-top: var(--space-3);
    display: flex;
    gap: var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .controls button {
    min-height: 24px;
    color: var(--color-text-muted);
    transition: color var(--transition);
  }
  .controls button:hover { color: var(--color-text); }
  .controls button[aria-pressed='true'] { color: var(--color-accent); }
  .hint {
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }
  .hint-touch { display: none; }
  /* Coarse-pointer, no-hover devices get the touch hint instead of the keyboard one. */
  @media (hover: none) and (pointer: coarse) {
    .hint-keyboard { display: none; }
    .hint-touch { display: block; }
  }
  @media (max-width: 480px) {
    .controls { gap: var(--space-4); }
    .hint { font-size: 0.75rem; }
  }
</style>
