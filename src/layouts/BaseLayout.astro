---
// src/layouts/BaseLayout.astro
// Page shell. <head>, fonts, FOUC theme init. Top bar and footer live in
// SiteHeader and SiteFooter. Every page passes its own description, so no
// two pages share one in search results or link previews. A noindex page
// (404, the unlisted toy) gets no canonical URL, since it must never be one.
import '../styles/global.css';
import '../styles/fonts.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props { title: string; description: string; noindex?: boolean; }
const { title, description, noindex = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const image = new URL('/peter.jpg', Astro.site);
const imageAlt = 'Portrait of Peter Massih';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalURL} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Peter's Patches" href="/rss.xml" />
    {/* Open Graph and Twitter cards control the preview when the URL is shared.
        The headshot is square, which suits Twitter's "summary" card. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Peter Massih" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="480" />
    <meta property="og:image:height" content="480" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {/* Fonts are self-hosted (src/styles/fonts.css); preloading the two files
        starts them alongside the CSS instead of after it. */}
    <link rel="preload" href="/fonts/geist-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin-400.woff2" as="font" type="font/woff2" crossorigin />
    {/* Inline so the stored theme paints on first frame, before render. */}
    <script is:inline>
      if (localStorage.theme) document.documentElement.dataset.theme = localStorage.theme;
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <slot />
    <SiteFooter />
    <script>import '../scripts/copy-code.js';</script>
  </body>
</html>
