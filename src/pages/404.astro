---
// src/pages/404.astro
// Custom 404 with an interactive gradient descent visualization.
// LaTeX is rendered server-side via KaTeX. The visible optimizer formula
// updates as the user switches optimizers (handled in gradient.js).
import BaseLayout from '../layouts/BaseLayout.astro';
import katex from 'katex';

const k = (tex: string, displayMode = true) => katex.renderToString(tex, { displayMode });

// Squared distance from (x, y) to a well center (x_i, y_i). Shared between the
// loss and its gradient so the two rendered formulas can never drift apart.
const sqDist = '(x - x_i)^2 + (y - y_i)^2';
const lossFormula = k(`L(x, y) = -\\sum_{i=1}^{4} \\underbrace{A_i}_{\\text{depth}}\\, \\exp\\!\\left(-\\frac{\\overbrace{${sqDist}}^{\\text{squared distance to well } i}}{2\\,{\\underbrace{\\sigma_i}_{\\text{width}}}^{2}}\\right)`);
const gradFormula = k(`\\nabla L(x, y) = \\sum_{i=1}^{4} \\frac{A_i}{\\sigma_i^2} \\exp\\!\\left(-\\frac{${sqDist}}{2\\sigma_i^2}\\right) \\begin{pmatrix} x - x_i \\\\ y - y_i \\end{pmatrix}`);
const gdFormula = k('\\theta_{t+1} = \\theta_t - \\eta \\, \\nabla L(\\theta_t)');
const momentumFormula = k('\\begin{aligned} v_{t+1} &= \\beta v_t - \\eta \\nabla L(\\theta_t) \\\\ \\theta_{t+1} &= \\theta_t + v_{t+1} \\end{aligned}');
const adamFormula = k('\\begin{aligned} m_t &= \\beta_1 m_{t-1} + (1 - \\beta_1)\\, \\nabla L \\\\ v_t &= \\beta_2 v_{t-1} + (1 - \\beta_2)\\, (\\nabla L)^2 \\\\ \\hat m_t &= m_t / (1 - \\beta_1^{\\,t}), \\quad \\hat v_t = v_t / (1 - \\beta_2^{\\,t}) \\\\ \\theta_{t+1} &= \\theta_t - \\eta \\, \\frac{\\hat m_t}{\\sqrt{\\hat v_t} + \\epsilon} \\end{aligned}');
const lossInline = k('L', false);
const metaStep = k('t = ', false);
const metaLoss = k(',\\quad L = ', false);
const metaGnorm = k(',\\quad \\lVert \\nabla L \\rVert = ', false);
// loss-landscape symbols (used in the formula labels, glossary, and values table)
const symPos = k('\\theta = (x, y)', false);
const symAi = k('A_i', false);
const symCenter = k('(x_i,\\ y_i)', false);
const symSigmaI = k('\\sigma_i', false);
const symI = k('i', false);
const symTheta = k('\\theta', false);
const symEta = k('\\eta', false);
const symGradL = k('\\nabla L', false);
const symBeta = k('\\beta', false);
const symEps = k('\\epsilon', false);
const symV = k('v', false);
const symMV = k('m,\\ v', false);
const symMHatVHat = k('\\hat m,\\ \\hat v', false);
const symBetaPair = k('\\beta_1,\\ \\beta_2', false);
---

<BaseLayout title="Not found — Peter Massih" description="That page doesn't exist.">
  <link slot="head" rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.47/dist/katex.min.css" />

  <main>
    <header class="head">
      <h1>404</h1>
      <p class="muted">That page doesn't exist. Watch a ball find a minimum instead.</p>
      <p><a href="/">Back to home →</a></p>
    </header>

    <section class="explainer">
      <p>The colored map is a loss function <span set:html={lossInline}></span> built from four Gaussian wells. Each term in the sum is a bump centered on a well, and the leading minus sign turns every bump into a basin. Three are shallow local minima where simple methods get stuck. The fourth is deeper and wider, the global minimum.</p>
      <div class="formula" set:html={lossFormula} />
      <dl class="glossary">
        <dt set:html={symPos}></dt><dd>the ball's position, the value the optimizers below update</dd>
        <dt set:html={symCenter}></dt><dd>where a well is centered, at its bump's peak</dd>
      </dl>
      {/* Values mirror WELLS in src/scripts/gradient.js. Keep the two in sync. */}
      <p>Each well in the sum uses these exact values:</p>
      <table class="wells">
        <thead>
          <tr><th set:html={symI}></th><th set:html={symCenter}></th><th set:html={symAi}></th><th set:html={symSigmaI}></th></tr>
        </thead>
        <tbody>
          <tr><td>1</td><td>(&minus;2.5, &minus;2.5)</td><td>2.0</td><td>1.3</td></tr>
          <tr><td>2</td><td>(2.5, &minus;2.0)</td><td>2.0</td><td>1.3</td></tr>
          <tr><td>3</td><td>(&minus;2.0, 2.5)</td><td>2.0</td><td>1.3</td></tr>
          <tr><td>4</td><td>(1.5, 1.5)</td><td>3.2</td><td>1.6</td></tr>
        </tbody>
      </table>
      <p>An optimizer never sees the whole map. It knows only the gradient <span set:html={symGradL}></span> at its current position, which points uphill toward steeper loss. It steps the other way, downhill:</p>
      <div class="formula" set:html={gradFormula} />
    </section>

    <canvas id="grad-canvas" class="canvas" aria-label="Gradient descent visualization"></canvas>

    <div class="legend">
      <span set:html={lossInline}></span>
      <span>lower</span>
      <span class="legend-bar" aria-hidden="true"></span>
      <span>higher</span>
    </div>

    <dl class="guide">
      <dt>contour lines</dt><dd>points of equal loss (closer together means steeper gradient)</dd>
      <dt>ball</dt><dd>current position of the optimizer</dd>
      <dt>path</dt><dd>recent trajectory (last 120 steps)</dd>
      <dt>t</dt><dd>iteration count (current step)</dd>
      <dt>L</dt><dd>loss at the current position (lower is better)</dd>
      <dt>‖∇L‖</dt><dd>gradient magnitude (near zero means converged)</dd>
    </dl>

    <p class="meta">
      <span set:html={metaStep}></span><span id="step">0</span><span set:html={metaLoss}></span><span id="loss">—</span><span set:html={metaGnorm}></span><span id="gnorm">—</span>
    </p>

    <div class="controls">
      <button id="reset" type="button">Reset</button>
      <button id="toggle" type="button">Play</button>
      <button id="step-btn" type="button">Step</button>
    </div>

    <div class="controls">
      <span class="label">learning rate</span>
      <button data-lr="0.01" type="button">0.01</button>
      <button data-lr="0.1" type="button" class="active">0.1</button>
      <button data-lr="0.5" type="button">0.5</button>
    </div>

    <div class="controls">
      <span class="label">optimizer</span>
      <button data-opt="gd" type="button" class="active">GD</button>
      <button data-opt="momentum" type="button">Momentum</button>
      <button data-opt="adam" type="button">Adam</button>
    </div>

    <div class="opt-formula" data-opt-formula="gd" set:html={gdFormula} />
    <div class="opt-formula" data-opt-formula="momentum" set:html={momentumFormula} hidden />
    <div class="opt-formula" data-opt-formula="adam" set:html={adamFormula} hidden />
    <p class="opt-note muted" data-opt-formula="gd">Here <span set:html={symGradL}></span> is the exact gradient computed above, so this is plain gradient descent. Replace it with a noisy minibatch estimate and the same rule becomes stochastic gradient descent (SGD).</p>

    <dl class="glossary">
      <div data-opt-gloss="gd momentum adam">
        <dt set:html={symTheta}></dt><dd>parameter (ball position), updated each step</dd>
      </div>
      <div data-opt-gloss="gd momentum adam">
        <dt set:html={symEta}></dt><dd>learning rate (constant, selected above)</dd>
      </div>
      <div data-opt-gloss="gd momentum adam">
        <dt set:html={symGradL}></dt><dd>gradient of L, computed each step</dd>
      </div>
      <div data-opt-gloss="momentum" hidden>
        <dt set:html={symBeta}></dt><dd>exponential decay for past gradients (constant, β = 0.9)</dd>
      </div>
      <div data-opt-gloss="momentum" hidden>
        <dt set:html={symV}></dt><dd>velocity, accumulated from past gradients, updated each step</dd>
      </div>
      <div data-opt-gloss="adam" hidden>
        <dt set:html={symBetaPair}></dt><dd>decay factors (constants, β₁ = 0.9, β₂ = 0.999)</dd>
      </div>
      <div data-opt-gloss="adam" hidden>
        <dt set:html={symMV}></dt><dd>running first and second moments of ∇L, updated each step</dd>
      </div>
      <div data-opt-gloss="adam" hidden>
        <dt set:html={symMHatVHat}></dt><dd>bias-corrected versions of m and v, computed each step</dd>
      </div>
      <div data-opt-gloss="adam" hidden>
        <dt set:html={symEps}></dt><dd>numerical stability constant (ε = 10⁻⁸)</dd>
      </div>
    </dl>

    <p class="hint muted">Click anywhere to drop the ball. Switch optimizers to see how each handles local minima.</p>
  </main>
</BaseLayout>

<script>import '../scripts/gradient.js';</script>

<style>
  main {
    max-width: var(--page-width);
    margin: var(--space-16) auto var(--space-16);
    padding: 0 var(--space-4);
  }
  .head { margin-bottom: var(--space-6); }
  .head h1 { font-size: var(--text-3xl); }
  .head p { margin-top: var(--space-2); }
  .explainer { margin-bottom: var(--space-4); max-width: 65ch; }
  .explainer p { margin-top: var(--space-3); color: var(--color-text-muted); }
  /* overflow-x lets the wider gradient (with its column vector) scroll on
     narrow screens instead of forcing the page wider. */
  .formula { margin-top: var(--space-3); font-size: var(--text-sm); overflow-x: auto; }
  .legend {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }
  .legend-bar {
    width: 120px;
    height: 12px;
    border-radius: 2px;
    border: 1px solid var(--color-border);
    background: linear-gradient(to right, var(--color-text), var(--color-code-bg));
  }
  .guide {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-1) var(--space-3);
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    max-width: 65ch;
  }
  .guide dt { color: var(--color-text-muted); }
  .guide dd { margin: 0; }
  .canvas {
    width: 100%;
    height: 60vh;
    display: block;
    background: var(--color-code-bg);
    border-radius: 4px;
    cursor: crosshair;
  }
  .meta {
    margin-top: var(--space-6);
    font-family: 'KaTeX_Main', 'Cambria', 'Times New Roman', serif;
    font-size: var(--text-base);
    color: var(--color-text-muted);
  }
  .glossary {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-1) var(--space-3);
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    max-width: 65ch;
  }
  /* `display: contents` lets the wrapper div participate in the grid as if
     its dt/dd were direct children, while still being toggleable via `hidden`. */
  .glossary > div { display: contents; }
  .glossary > div[hidden] { display: none; }
  .glossary dt { color: var(--color-text-muted); }
  .glossary dd { margin: 0; }
  .controls {
    margin-top: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }
  .controls .label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }
  .controls button {
    padding: 0.35rem 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    transition: color var(--transition), border-color var(--transition), background var(--transition);
  }
  .controls button:hover { color: var(--color-text); border-color: var(--color-text-muted); }
  .controls button.active {
    color: var(--color-text);
    border-color: var(--color-accent);
    background: var(--color-code-bg);
  }
  .opt-formula {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .opt-note {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    max-width: 65ch;
  }
  .hint { margin-top: var(--space-3); font-size: var(--text-sm); max-width: 65ch; }
</style>
