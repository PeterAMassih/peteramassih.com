---
// src/pages/play.astro
// A tiny shared world: every sprite is a live visitor, across four rooms.
// Game logic in src/scripts/play.js; the server lives in game/ (Durable Object).
import BaseLayout from '../layouts/BaseLayout.astro';

// The hangman guesses. Buttons rather than typing, so nothing a visitor
// writes reaches anyone else.
const LETTERS = [...'abcdefghijklmnopqrstuvwxyz'];
---

<BaseLayout title="Play — Peter Massih" description="Pixel world, one of the toys on Peter Massih's site." noindex>
  <main id="main">
    <header class="head">
      <h1>Play</h1>
    </header>

    <canvas id="play-canvas" class="canvas" width="640" height="360" aria-label="Shared pixel world"></canvas>

    <p class="meta" aria-live="polite">
      <span id="play-room">…</span> ·
      <span id="play-status">connecting…</span> ·
      <span id="play-count">–</span> online
    </p>

    {/* Shown only in the library, by play.js, while its word is in play. */}
    <div id="play-letters" class="letters" role="group" aria-label="Guess a letter" hidden>
      {LETTERS.map((l) => <button type="button" data-letter={l}>{l}</button>)}
    </div>

    {/* Shown only on coarse-pointer (touch) devices, via the media query below. */}
    <div id="play-touch" class="touch">
      <div class="pads">
        <div class="pad">
          <button type="button" data-act="left" aria-label="Walk left">←</button>
          <button type="button" data-act="right" aria-label="Walk right">→</button>
        </div>
        <div class="pad">
          <button type="button" data-act="jump">jump</button>
          <button type="button" data-act="punch">punch</button>
        </div>
      </div>
      <div class="pad small">
        <button type="button" data-act="wave">wave</button>
        <button type="button" data-act="heart">heart</button>
        <button type="button" data-act="mute">mute</button>
      </div>
    </div>

    <div class="hint hint-keys">
      <dl class="keys">
        <div><dt><kbd>←</kbd> <kbd>→</kbd></dt><dd>walk</dd></div>
        <div><dt><kbd>Space</kbd></dt><dd>jump</dd></div>
        <div><dt><kbd>Z</kbd></dt><dd>punch</dd></div>
        <div><dt><kbd>E</kbd></dt><dd>wave</dd></div>
        <div><dt><kbd>Q</kbd></dt><dd>heart</dd></div>
        <div><dt><kbd>M</kbd></dt><dd>mute</dd></div>
      </dl>
      <p class="muted">Doors at the edges lead to other rooms.</p>
    </div>
    <p class="hint hint-touch muted">
      Walk, jump, and punch with the buttons. Doors at the edges lead to
      other rooms.
    </p>

    <details class="about">
      <summary>what is this?</summary>
      <p>
        A tiny multiplayer world. Every character here is a real visitor
        on this page right now, under a name picked for them from a short
        list. Walk over and wave, or throw a punch.
        Nobody gets hurt. They bounce back and blink briefly, and can't be
        hit again until the blinking stops.
      </p>
      <p>
        Four rooms, doors at the edges. The plaza is for hanging out. The
        arena has a crown. Steal it, hold it, and the longest reigns go on
        the wall. The library is quiet: no punching. It also keeps a
        hangman word going. Pick letters below the world to guess it
        together. The moon has low
        gravity and a timed run from the green flag to the gold flag. Best
        times go on the board.
      </p>
      <p>
        Under the hood, your browser keeps one WebSocket open to a
        Cloudflare Durable Object that referees the room and checks every
        move and punch. Physics runs in your browser. When the room is
        empty, the server sleeps and costs nothing.
      </p>
    </details>
  </main>
</BaseLayout>

<script>import '../scripts/play.js';</script>

<style>
  main {
    max-width: var(--page-width);
    margin: var(--space-16) auto var(--space-16);
    padding: 0 var(--space-4);
  }
  .head { margin-bottom: var(--space-4); }
  .canvas {
    width: 100%;
    display: block;
    background: #16181d; /* the world keeps its own palette in both site themes */
    border-radius: 4px;
    image-rendering: pixelated;
  }
  .meta {
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }
  .letters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    /* Two even rows of 13 on wide screens; phones wrap to fit. */
    max-width: calc(13 * 28px + 12 * var(--space-1));
    margin-top: var(--space-3);
  }
  .letters[hidden] { display: none; }
  .letters button {
    min-width: 28px;
    min-height: 28px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    transition: color var(--transition);
  }
  .letters button:hover { color: var(--color-text); }
  .letters button:disabled { opacity: 0.35; cursor: default; }
  .touch { display: none; }
  .hint { margin-top: var(--space-3); font-size: var(--text-sm); }
  .keys {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin-bottom: var(--space-2);
    color: var(--color-text-muted);
  }
  .keys div { display: flex; align-items: baseline; gap: var(--space-2); }
  kbd {
    padding: 0 var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }
  .hint-touch { display: none; }
  @media (pointer: coarse) {
    .hint-keys { display: none; }
    .hint-touch { display: block; }
    .touch {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      margin-top: var(--space-3);
    }
    .pads { display: flex; justify-content: space-between; gap: var(--space-4); }
    .pad { display: flex; gap: var(--space-2); flex: 1; }
    .pad.small button { min-height: 44px; font-size: var(--text-sm); color: var(--color-text-muted); }
    .touch button {
      flex: 1;
      min-height: 56px;
      font-family: var(--font-mono);
      font-size: var(--text-base);
      color: var(--color-text);
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: 6px;
      /* none, not manipulation: a thumb drift while holding a walk button
         must never become a scroll gesture that cancels the pointer. */
      touch-action: none;
      -webkit-touch-callout: none;
      -webkit-user-select: none;
      user-select: none;
    }
    .touch button:active { background: var(--color-code-bg); }
  }
  @media (max-width: 700px) {
    /* Downscaling below 1:1 with nearest-neighbor decimates text strokes;
       smooth scaling reads far better on small screens. */
    .canvas { image-rendering: auto; }
  }
  .about { margin-top: var(--space-4); }
  .about summary {
    min-height: 24px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    cursor: pointer;
    transition: color var(--transition);
  }
  .about summary:hover { color: var(--color-text); }
  .about p {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    max-width: 65ch;
  }
</style>
