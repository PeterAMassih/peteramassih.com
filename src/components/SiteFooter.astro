---
// src/components/SiteFooter.astro
// One quiet line: copyright, the two toys, and the feed.
---

<footer class="site-footer">
  <p>© {new Date().getFullYear()} Peter Massih · <a href="/life/">life</a> · <a href="/stack/">stack</a> · <a href="/rss.xml">RSS</a></p>
</footer>

<style>
  .site-footer {
    max-width: var(--content-width);
    margin: var(--space-16) auto var(--space-8);
    padding: 0 var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-align: center;
  }
  /* Padding lifts inline links to 24px+ tap targets without changing line spacing. */
  .site-footer a { padding-block: var(--space-1); color: var(--color-text-muted); }
  .site-footer a:hover { color: var(--color-text); }
</style>
