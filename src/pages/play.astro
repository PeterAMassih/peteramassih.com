---
// src/pages/play.astro
// A tiny shared world — every square is a live visitor. v0: walk, see others.
// Game logic in src/scripts/play.js; the server lives in game/ (Durable Object).
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Play — Peter Massih" description="A tiny shared pixel world. Everyone here is a real visitor.">
  <Fragment slot="head">
    {/* Unlisted while v0 is a test page. */}
    <meta name="robots" content="noindex" />
  </Fragment>
  <main>
    <header class="head">
      <h1>Play</h1>
    </header>

    <canvas id="play-canvas" class="canvas" width="640" height="360" aria-label="Shared pixel world"></canvas>

    <p class="meta" aria-live="polite">
      <span id="play-room">…</span> ·
      status: <span id="play-status">connecting…</span> ·
      here now: <span id="play-count">–</span>
    </p>

    {/* Shown only on coarse-pointer (touch) devices, via the media query below. */}
    <div id="play-touch" class="touch">
      <div class="pads">
        <div class="pad">
          <button type="button" data-act="left" aria-label="Walk left">←</button>
          <button type="button" data-act="right" aria-label="Walk right">→</button>
        </div>
        <div class="pad">
          <button type="button" data-act="jump">jump</button>
          <button type="button" data-act="punch">punch</button>
        </div>
      </div>
      <div class="pad small">
        <button type="button" data-act="wave">wave</button>
        <button type="button" data-act="heart">heart</button>
        <button type="button" data-act="mute">mute</button>
      </div>
    </div>

    <div class="row">
      <input
        id="play-name"
        type="text"
        maxlength="16"
        placeholder="your name"
        autocomplete="off"
        aria-label="Your name"
        pattern="[\w\-]{2,16}"
        title="2–16 letters, digits, - or _"
      />
      <form id="play-chat-form">
        <input
          id="play-chat"
          type="text"
          maxlength="120"
          placeholder="say something…"
          autocomplete="off"
          aria-label="Chat message"
        />
      </form>
    </div>

    <p class="hint hint-keys muted">
      Arrows to walk, Space to jump, Z punches, Enter to chat. E waves, Q sends
      a heart, M mutes. Doors at the edges lead to other rooms.
    </p>
    <p class="hint hint-touch muted">
      Walk, jump, and punch with the buttons. Tap the field below to chat.
      Doors at the edges lead to other rooms.
    </p>

    <details class="about">
      <summary>what is this?</summary>
      <p>
        A tiny multiplayer world. Every character here is a real visitor,
        on this page right now. Walk over and say hi, or throw a punch.
        Nobody gets hurt. They bounce back and blink for a moment while
        they cannot be hit again. Under the hood, your browser keeps one
        WebSocket open to a Cloudflare Durable Object that referees the
        room and checks every move, punch, and message. Physics runs in
        your browser. When the room is empty, the server sleeps and costs
        nothing.
      </p>
    </details>
  </main>
</BaseLayout>

<script>import '../scripts/play.js';</script>

<style>
  main {
    max-width: var(--page-width);
    margin: var(--space-16) auto var(--space-16);
    padding: 0 var(--space-4);
  }
  .head { margin-bottom: var(--space-4); }
  .canvas {
    width: 100%;
    display: block;
    background: #16181d; /* the world keeps its own palette in both site themes */
    border-radius: 4px;
    image-rendering: pixelated;
  }
  .meta {
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }
  .touch { display: none; }
  @media (pointer: coarse) {
    .touch {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      margin-top: var(--space-3);
    }
    .pads { display: flex; justify-content: space-between; gap: var(--space-4); }
    .pad { display: flex; gap: var(--space-2); flex: 1; }
    .pad.small button { min-height: 44px; font-size: var(--text-sm); color: var(--color-text-muted); }
    .touch button {
      flex: 1;
      min-height: 56px;
      font-family: var(--font-mono);
      font-size: var(--text-base);
      color: var(--color-text);
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: 6px;
      /* none, not manipulation: a thumb drift while holding a walk button
         must never become a scroll gesture that cancels the pointer. */
      touch-action: none;
      -webkit-touch-callout: none;
      -webkit-user-select: none;
      user-select: none;
    }
    .touch button:active { background: var(--color-code-bg); }
  }
  .row { margin-top: var(--space-4); display: flex; gap: var(--space-2); }
  .row form { flex: 1; }
  .row input {
    width: 100%;
    padding: 0.45rem 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    transition: border-color var(--transition);
  }
  .row input:focus { outline: none; border-color: var(--color-text-muted); }
  .row input:invalid { border-color: #c0564a; }
  #play-name { width: 9rem; flex: none; }
  @media (pointer: coarse) {
    /* 16px minimum: anything smaller makes iOS Safari zoom the page on focus
       and it never zooms back out after the keyboard closes. */
    .row input { font-size: 1rem; }
  }
  @media (max-width: 700px) {
    /* Downscaling below 1:1 with nearest-neighbor decimates text strokes;
       smooth scaling reads far better on small screens. */
    .canvas { image-rendering: auto; }
  }
  .hint { margin-top: var(--space-3); font-size: var(--text-sm); }
  .hint-touch { display: none; }
  @media (pointer: coarse) {
    .hint-keys { display: none; }
    .hint-touch { display: block; }
  }
  .about { margin-top: var(--space-4); }
  .about summary {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    cursor: pointer;
    transition: color var(--transition);
  }
  .about summary:hover { color: var(--color-text); }
  .about p {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    max-width: 65ch;
  }
</style>
