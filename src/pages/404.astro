---
// src/pages/404.astro
// Custom 404 with an interactive gradient descent visualization.
// LaTeX is rendered server-side via KaTeX. The visible optimizer formula
// updates as the user switches optimizers (handled in gradient.js).
import BaseLayout from '../layouts/BaseLayout.astro';
import katex from 'katex';
// Same-origin KaTeX styles: a third-party stylesheet would block first render.
import 'katex/dist/katex.min.css';
import '../styles/canvas-toy.css';

const k = (tex: string, displayMode = false) => katex.renderToString(tex, { displayMode });

const gdFormula = k('\\theta_{t+1} = \\theta_t - \\eta \\, \\nabla L(\\theta_t)', true);
const momentumFormula = k('\\begin{aligned} v_{t+1} &= \\beta v_t - \\eta \\nabla L(\\theta_t) \\\\ \\theta_{t+1} &= \\theta_t + v_{t+1} \\end{aligned}', true);
const adamFormula = k('\\begin{aligned} m_t &= \\beta_1 m_{t-1} + (1 - \\beta_1)\\, \\nabla L \\\\ v_t &= \\beta_2 v_{t-1} + (1 - \\beta_2)\\, (\\nabla L)^2 \\\\ \\hat m_t &= m_t / (1 - \\beta_1^{\\,t}), \\quad \\hat v_t = v_t / (1 - \\beta_2^{\\,t}) \\\\ \\theta_{t+1} &= \\theta_t - \\eta \\, \\frac{\\hat m_t}{\\sqrt{\\hat v_t} + \\epsilon} \\end{aligned}', true);
const lossInline = k('L');
const symGradL = k('\\nabla L');
---

<BaseLayout title="Not found — Peter Massih" description="Peter Massih's site: publications, projects, writing, CV and toys." noindex>
  <main id="main">
    <header class="head">
      <h1>404</h1>
      <p class="muted">That page doesn't exist. Watch a ball find a minimum instead.</p>
      <p><a class="home" href="/">Back to home →</a></p>
    </header>

    <p class="explainer">The map is a loss <span set:html={lossInline}></span> built from four Gaussian wells. Three are shallow local minima where simple methods get stuck. The fourth is deeper and wider, the global minimum. An optimizer knows only the gradient <span set:html={symGradL}></span> where it stands, and steps downhill.</p>

    <canvas id="grad-canvas" class="canvas" role="img" aria-label="Gradient descent visualization"></canvas>

    <div class="legend">
      <span set:html={lossInline}></span>
      <span>lower</span>
      <span class="legend-bar" aria-hidden="true"></span>
      <span>higher</span>
    </div>

    <p class="meta">
      <span set:html={k('t = ')}></span><span id="step">0</span><span set:html={k(',\\quad L = ')}></span><span id="loss">—</span><span set:html={k(',\\quad \\lVert \\nabla L \\rVert = ')}></span><span id="gnorm">—</span>
    </p>

    <div class="controls">
      <button id="reset" type="button">Reset</button>
      <button id="toggle" type="button">Play</button>
      <button id="step-btn" type="button">Step</button>
    </div>

    <div class="controls">
      <span class="label">learning rate</span>
      <button data-lr="0.01" type="button">0.01</button>
      <button data-lr="0.1" type="button" class="active">0.1</button>
      <button data-lr="0.5" type="button">0.5</button>
    </div>

    <div class="controls">
      <span class="label">optimizer</span>
      <button data-opt="gd" type="button" class="active">GD</button>
      <button data-opt="momentum" type="button">Momentum</button>
      <button data-opt="adam" type="button">Adam</button>
    </div>

    <div class="opt-formula" data-opt-formula="gd" set:html={gdFormula} />
    <div class="opt-formula" data-opt-formula="momentum" set:html={momentumFormula} hidden />
    <div class="opt-formula" data-opt-formula="adam" set:html={adamFormula} hidden />
    <p class="opt-note muted" data-opt-formula="gd">Here <span set:html={symGradL}></span> is the exact gradient of the map, so this is plain gradient descent. Replace it with a noisy minibatch estimate and the same rule becomes stochastic gradient descent (SGD).</p>

    <dl class="glossary">
      <div data-opt-gloss="gd momentum adam">
        <dt set:html={k('\\theta')}></dt><dd>parameter (ball position), updated each step</dd>
      </div>
      <div data-opt-gloss="gd momentum adam">
        <dt set:html={k('\\eta')}></dt><dd>learning rate (constant, selected above)</dd>
      </div>
      <div data-opt-gloss="gd momentum adam">
        <dt set:html={symGradL}></dt><dd>gradient of L, computed each step</dd>
      </div>
      <div data-opt-gloss="momentum" hidden>
        <dt set:html={k('\\beta')}></dt><dd>exponential decay for past gradients (constant, β = 0.9)</dd>
      </div>
      <div data-opt-gloss="momentum" hidden>
        <dt set:html={k('v')}></dt><dd>velocity, accumulated from past gradients, updated each step</dd>
      </div>
      <div data-opt-gloss="adam" hidden>
        <dt set:html={k('\\beta_1,\\ \\beta_2')}></dt><dd>decay factors (constants, β₁ = 0.9, β₂ = 0.999)</dd>
      </div>
      <div data-opt-gloss="adam" hidden>
        <dt set:html={k('m,\\ v')}></dt><dd>running first and second moments of ∇L, updated each step</dd>
      </div>
      <div data-opt-gloss="adam" hidden>
        <dt set:html={k('\\hat m,\\ \\hat v')}></dt><dd>bias-corrected versions of m and v, computed each step</dd>
      </div>
      <div data-opt-gloss="adam" hidden>
        <dt set:html={k('\\epsilon')}></dt><dd>numerical stability constant (ε = 10⁻⁸)</dd>
      </div>
    </dl>

    <p class="hint muted">Click anywhere to drop the ball. Switch optimizers to see how each handles local minima.</p>
  </main>
</BaseLayout>

<script>import '../scripts/gradient.js';</script>

<style>
  .head { margin-bottom: var(--space-6); }
  .head p { margin-top: var(--space-2); }
  .home { padding-block: var(--space-1); }
  .explainer { margin-bottom: var(--space-4); color: var(--color-text-muted); }
  .legend {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }
  .legend-bar {
    width: 120px;
    height: 12px;
    border-radius: 2px;
    border: 1px solid var(--color-border);
    background: linear-gradient(to right, var(--color-text), var(--color-code-bg));
  }
  .meta {
    margin-top: var(--space-6);
    font-family: 'KaTeX_Main', 'Cambria', 'Times New Roman', serif;
    font-size: var(--text-base);
    color: var(--color-text-muted);
  }
  .glossary {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-1) var(--space-3);
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    max-width: 65ch;
  }
  /* `display: contents` lets the wrapper div participate in the grid as if
     its dt/dd were direct children, while still being toggleable via `hidden`. */
  .glossary > div { display: contents; }
  .glossary > div[hidden] { display: none; }
  .glossary dt { color: var(--color-text-muted); }
  .glossary dd { margin: 0; }
  /* The Adam block is wide; it scrolls inside its box on narrow screens.
     Formulas sit flush left with the rest of the page, not centered. */
  .opt-formula {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    overflow-x: auto;
  }
  .opt-formula :global(:is(.katex-display, .katex-display > .katex)) { text-align: left; }
  .opt-note {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    max-width: 65ch;
  }
  .hint { margin-top: var(--space-3); font-size: var(--text-sm); max-width: 65ch; }
</style>
