---
// src/pages/index.astro
// Home: name, a two-sentence introduction and links beside the photo, then
// the evidence: two publications, four projects and recent writing, one line
// each where it fits. Roles and dates live on the CV, linked from the menu.
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationList from '../components/PublicationList.astro';
import { getCollection } from 'astro:content';

// One line per pick, cut from the project's result line on /projects/, which
// carries the full numbers and methods.
const picks = [
  { id: '3d-blockgen', name: '3D-BlockGen', line: 'turned text into buildable LEGO models with two-stage diffusion.' },
  { id: 'epfl-ta-meister', name: 'LLM Teaching Assistant', line: 'raised Llama-3-8B preference alignment from 55% to 63%.' },
  { id: 'paraphrasing', name: 'Reasoning-Model Paraphraser', line: 'more than doubled diversity over BART.' },
  { id: 'rl-mountain-car', name: 'RL on Mountain Car', line: 'cut training from 300 to 200 episodes.' },
];
const posts = (await getCollection('writing', ({ data }) =>
  import.meta.env.PROD ? !data.draft : true,
))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
const fmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Peter Massih', url: 'https://peteramassih.com/' },
  {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    mainEntity: {
      '@type': 'Person',
      '@id': 'https://peteramassih.com/#person',
      name: 'Peter Massih',
      // The bylines on his papers, so search engines tie them to this page.
      alternateName: ['Peter A. Massih', 'P. A. Massih'],
      url: 'https://peteramassih.com/',
      image: 'https://peteramassih.com/peter.jpg',
      description: 'I do ML research and release it as software.',
      alumniOf: { '@type': 'CollegeOrUniversity', name: 'EPFL' },
      sameAs: ['https://github.com/PeterAMassih', 'https://huggingface.co/PeterAM4', 'https://www.linkedin.com/in/peteramassih/'],
    },
    // Stamped at build time, so it moves with each deploy.
    dateModified: new Date().toISOString(),
  },
];
---

<BaseLayout
  title="Peter Massih — Machine learning research and engineering"
  description="Peter Massih, EPFL MSc in Computer Science. Research on vision-language models at NEC Laboratories America and three AI systems in production at Bank Lombard Odier & Co Ltd."
>
  <Fragment slot="head">
    {jsonLd.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </Fragment>

  <main id="main">
    <header class="intro">
      <div>
        <h1>Peter Massih</h1>
        <p class="bio">
          I do ML research and release it as software: vision-language models at NEC Laboratories
          America with Eric Cosatto, and three AI systems used daily in financial services. MSc in
          Computer Science from EPFL.
        </p>
        <p class="links">
          <a href="https://github.com/PeterAMassih">GitHub</a> ·
          <a href="https://huggingface.co/PeterAM4">Hugging Face</a> ·
          <a href="https://www.linkedin.com/in/peteramassih/">LinkedIn</a> ·
          <a href="mailto:peteramassih@gmail.com">Email</a>
        </p>
      </div>
      <img class="photo" src="/peter.jpg" alt="Peter Massih" width="480" height="480" />
    </header>

    <section>
      <h2>Publications</h2>
      <PublicationList compact />
      <p class="more"><a href="/publications/">All publications →</a></p>
    </section>

    <section>
      <h2>Selected projects</h2>
      <ul>
        {picks.map(({ id, name, line }) => (
          <li><a class="name" href={`/projects/${id}/`}>{name}</a><span class="muted">: {line}</span></li>
        ))}
      </ul>
      <p class="more"><a href="/projects/">All projects →</a></p>
    </section>

    <section>
      <h2>Writing</h2>
      <ul>
        {posts.map((post) => (
          <li class="row">
            <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{fmt.format(post.data.pubDate)}</time>
            <a class="name" href={`/writing/${post.id}/`}>{post.data.title}</a>
          </li>
        ))}
      </ul>
      <p class="more"><a href="/writing/">All writing →</a></p>
    </section>
  </main>
</BaseLayout>

<style>
  .intro {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-8);
    align-items: start;
  }
  .intro h1 { font-size: var(--text-4xl); }
  .bio { margin-top: var(--space-4); font-size: var(--text-lg); line-height: 1.55; color: var(--color-text-muted); }
  .links { margin-top: var(--space-4); font-size: var(--text-sm); color: var(--color-text-muted); }
  .links a { padding-block: var(--space-1); color: var(--color-text); }
  .links a:hover { color: var(--color-accent); }
  .photo { width: 240px; height: 240px; border-radius: 6px; object-fit: cover; }
  section { margin-top: var(--space-16); }
  section > h2 { margin-bottom: var(--space-6); }
  ul { list-style: none; padding: 0; }
  li + li { margin-top: var(--space-2); }
  .name { font-weight: 600; color: var(--color-text); }
  .name:hover { color: var(--color-accent); }
  .row { display: grid; grid-template-columns: 6rem 1fr; column-gap: var(--space-4); align-items: baseline; }
  time { font-size: var(--text-sm); color: var(--color-text-muted); }
  .more { margin-top: var(--space-6); font-size: var(--text-sm); }
  .more a { padding-block: var(--space-1); }
  /* On phones the face comes first, where the eye lands, then the name and
     the introduction; dates sit above their titles. */
  @media (max-width: 600px) {
    .intro { grid-template-columns: 1fr; gap: var(--space-6); }
    .photo { order: -1; }
    .row { grid-template-columns: 1fr; row-gap: var(--space-1); }
    section { margin-top: var(--space-12); }
  }
</style>
