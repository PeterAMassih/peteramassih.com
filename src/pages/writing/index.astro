---
// src/pages/writing/index.astro
// Peter's Patches: chronological writing list, grouped by year. Drafts are
// hidden in production builds.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing', ({ data }) =>
  import.meta.env.PROD ? !data.draft : true,
)).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// UTC, like the dates below, so a post never lands in the wrong year.
const byYear = Map.groupBy(posts, (p) => p.data.pubDate.getUTCFullYear());
const fmt = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<BaseLayout title="Peter's Patches — Peter Massih" description="Essays and notes by Peter Massih, including a post on Mask2Former.">
  <main id="main">
    <header class="head">
      <h1>Peter's Patches</h1>
      <p class="muted">Essays, notes, and the occasional long thought.</p>
    </header>

    {Array.from(byYear, ([year, group]) => (
      <section class="year">
        <h2>{year}</h2>
        <ul class="posts">
          {group.map((post) => (
            <li>
              <a href={`/writing/${post.id}/`}>
                <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{fmt.format(post.data.pubDate)}</time>
                <span class="title">{post.data.title}</span>
              </a>
              <p class="desc">{post.data.description}</p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </main>
</BaseLayout>

<style>
  .head { margin-bottom: var(--space-12); }
  /* The writing index is the only page that is a "publication" rather than UI.
     One serif heading, system fonts only (no extra download), to mark it as such. */
  .head h1 {
    font-family: 'Iowan Old Style', 'Charter', 'Sitka Text', 'Georgia', serif;
    font-size: 2.75rem;
    font-weight: 400;
    letter-spacing: -0.005em;
    line-height: 1.1;
  }
  .head p { margin-top: var(--space-2); }
  .year { margin-top: var(--space-12); }
  .year h2 {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--color-text-subtle);
    margin-bottom: var(--space-4);
  }
  .posts { list-style: none; padding: 0; }
  .posts li + li { margin-top: var(--space-6); }
  .posts a {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: var(--space-4);
    align-items: baseline;
    color: var(--color-text);
  }
  .posts a:hover .title { color: var(--color-accent); }
  .posts time { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-text-subtle); }
  .posts .title { transition: color var(--transition); }
  .desc {
    margin-top: var(--space-1);
    margin-left: calc(5rem + var(--space-4));
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
  @media (max-width: 600px) {
    .posts a { grid-template-columns: 1fr; gap: var(--space-1); }
    .desc { margin-left: 0; }
  }
</style>
