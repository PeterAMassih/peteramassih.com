// game/wrangler.jsonc
// The game server: a separate Worker from the site, deployed independently.
{
	"name": "peteramassih-play",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-26",
	// SQLite-backed Durable Objects are the free-plan backend. "new_sqlite_classes"
	// (not "new_classes") is what selects it, and the choice is permanent per
	// class. Each room keeps its persistent state there: the crown, the word game,
	// and the race and reign boards.
	"durable_objects": {
		"bindings": [{ "name": "ROOM", "class_name": "Room" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
	"observability": {
		"enabled": true
	}
}
