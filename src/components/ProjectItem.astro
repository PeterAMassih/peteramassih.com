---
// src/components/ProjectItem.astro
// One project: name, dates and context, result line, links. The home page
// shows four, /projects/ shows all six, and a project's own page renders it
// with heading="h1" (no self-link) and its MDX body in the slot.
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  heading?: 'h1' | 'h2' | 'h3';
}
const { project, heading: Heading = 'h2' } = Astro.props;
const { title, description, pubDate, startDate, context, links } = project.data;
// Dates are stored as UTC midnight; formatting in UTC keeps the 1st of a
// month from rendering as the previous month in timezones west of Greenwich.
const fmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', timeZone: 'UTC' });
const month = (d: Date) => d.toISOString().slice(0, 7);
---

<article class="project">
  <Heading class:list={['name', { page: Heading === 'h1' }]}>
    {Heading === 'h1' ? title : <a href={`/projects/${project.id}/`}>{title}</a>}
  </Heading>
  <p class="meta">
    <span class="dates">
      {startDate && <><time datetime={month(startDate)}>{fmt.format(startDate)}</time> – </>}
      <time datetime={month(pubDate)}>{fmt.format(pubDate)}</time>
    </span>
    · {context}
  </p>
  <p class="result">{description}</p>
  <p class="links">
    {links.map((l, i) => <>{i > 0 && ' · '}<a href={l.href}>{l.label}</a></>)}
  </p>
  <slot />
</article>

<style>
  .project + .project {
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }
  .name:not(.page) { font-size: var(--text-lg); }
  .name.page { line-height: 1.2; }
  .name a { color: var(--color-text); transition: color var(--transition); }
  .name a:hover { color: var(--color-accent); }
  .meta { margin-top: var(--space-1); font-size: var(--text-sm); color: var(--color-text-muted); }
  .dates { font-family: var(--font-mono); font-size: var(--text-xs); }
  .result { margin-top: var(--space-2); }
  .links { margin-top: var(--space-2); font-size: var(--text-sm); }
  .links a { padding-block: var(--space-1); }
</style>
