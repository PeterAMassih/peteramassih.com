---
// src/pages/index.astro
// Landing. Two-column intro, then background, publications, selected projects
// and recent writing.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { pubs, ME } from '../data/publications';

const picks = ['3d-blockgen', 'epfl-ta-meister', 'paraphrasing', 'rl-mountain-car'];
const projects = (await getCollection('projects', ({ id }) => picks.includes(id)))
  .sort((a, b) => picks.indexOf(a.id) - picks.indexOf(b.id));
// The two papers with their own page; the rest are on /publications/.
const papers = pubs.filter((p) => p.page).reverse();
const recent = (await getCollection('writing', ({ data }) =>
  import.meta.env.PROD ? !data.draft : true,
))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
const fmt = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
// The home list keeps each paper's status to its first sentence.
const firstSentence = (s: string) => s.split('. ')[0].replace(/\.?$/, '.');
// "Turned text into…" reads as "3D-BlockGen: turned text into…" after the name.
const lower = (s: string) => s[0].toLowerCase() + s.slice(1);

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Peter Massih', url: 'https://peteramassih.com/' },
  {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    mainEntity: {
      '@type': 'Person',
      '@id': 'https://peteramassih.com/#person',
      name: 'Peter Massih',
      // The bylines on his papers, so search engines tie them to this page.
      alternateName: ['Peter A. Massih', 'P. A. Massih'],
      url: 'https://peteramassih.com/',
      image: 'https://peteramassih.com/peter.jpg',
      description: 'I do ML research and release it as software.',
      alumniOf: { '@type': 'CollegeOrUniversity', name: 'EPFL' },
      sameAs: ['https://github.com/PeterAMassih', 'https://huggingface.co/PeterAM4', 'https://www.linkedin.com/in/peteramassih/'],
    },
    // Stamped at build time, so it moves with each deploy.
    dateModified: new Date().toISOString(),
  },
];
---

<BaseLayout
  title="Peter Massih — Machine learning research and engineering"
  description="Peter Massih, EPFL MSc in Computer Science. Research on vision-language models at NEC Laboratories America and three AI systems in production at Bank Lombard Odier & Co Ltd."
>
  <Fragment slot="head">
    {jsonLd.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </Fragment>

  <main id="main">
    <header class="intro">
      <div>
        <h1>Peter Massih</h1>
        <p class="bio">
          I do ML research and release it as software.
          Research on vision-language models at NEC Laboratories America with Dr. Eric Cosatto.
          Previously I built three AI systems used daily in financial services.
        </p>
        <p class="socials">
          <a href="https://github.com/PeterAMassih">github</a> ·
          <a href="https://huggingface.co/PeterAM4">huggingface</a> ·
          <a href="https://www.linkedin.com/in/peteramassih/">linkedin</a> ·
          <a href="mailto:peteramassih@gmail.com">email</a>
        </p>
        <p class="play-invite">
          <a href="/play/">There is a tiny world hiding on this site →</a>
        </p>
      </div>
      <img class="photo" src="/peter.jpg" alt="Peter Massih" width="480" height="480" />
    </header>

    <section>
      <h2>Background</h2>
      <div class="bg-row">
        <span class="bg-label">Experience</span>
        <ul>
          <li><span>Machine Learning Research Intern @ NEC Laboratories America</span><span class="when">2025–2026</span></li>
          <li><span>Software Engineer Intern, AI/ML @ Bank Lombard Odier &amp; Co Ltd</span><span class="when">2025–2026</span></li>
          <li><span>Full-Stack AI Engineer Intern @ Ageospatial</span><span class="when">2024</span></li>
        </ul>
      </div>
      <div class="bg-row">
        <span class="bg-label">Education</span>
        <ul>
          <li><span>MSc in Computer Science (Data Analytics and Machine Learning) @ EPFL</span><span class="when">2023–2026</span></li>
          <li><span>Exchange year in Computer Science and Electrical Engineering @ ETH Zurich</span><span class="when">2022–2023</span></li>
          <li><span>BSc in Communication Systems @ EPFL</span><span class="when">2020–2023</span></li>
        </ul>
      </div>
    </section>

    <section>
      <h2>Publications</h2>
      {papers.map((pub) => (
        <>
          <p><strong><a href={pub.page}>{pub.title}</a></strong></p>
          <p class="muted">
            {pub.authors.map((a, i) => <>{i > 0 && ', '}{a === ME ? <strong>{a}</strong> : a}</>)}
            {' · '}{firstSentence(pub.status)}
            {pub.links && <> <a href={pub.links[0].href}>{pub.links[0].label} →</a></>}
          </p>
        </>
      ))}
      <p class="more"><a href="/publications/">All publications →</a></p>
    </section>

    <section>
      <h2>Selected projects</h2>
      {projects.map((p) => (
        <p><strong><a class="name" href={`/projects/${p.id}/`}>{p.data.title}</a></strong>: {lower(p.data.description)}</p>
      ))}
      <p class="more"><a href="/projects/">All projects →</a></p>
    </section>

    <section>
      <h2>Peter's Patches</h2>
      <ul class="recent">
        {recent.map((post) => (
          <li>
            <a href={`/writing/${post.id}/`}>
              <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{fmt.format(post.data.pubDate)}</time>
              <span class="title">{post.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="more"><a href="/writing/">All patches →</a></p>
    </section>
  </main>
</BaseLayout>

<style>
  .intro {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-6);
    align-items: start;
    margin-bottom: var(--space-16);
  }
  .bio { margin-top: var(--space-2); color: var(--color-text-muted); max-width: 52ch; }
  .photo { width: 240px; height: 240px; border-radius: 4px; object-fit: cover; }
  .socials { margin-top: var(--space-3); font-size: var(--text-sm); color: var(--color-text-subtle); }
  .socials a { padding-block: var(--space-1); color: var(--color-text-muted); }
  .socials a:hover { color: var(--color-text); }
  .play-invite { margin-top: var(--space-2); font-size: var(--text-sm); }
  .play-invite a { padding-block: var(--space-1); color: var(--color-text-muted); }
  .play-invite a:hover { color: var(--color-accent); }
  section { margin-top: var(--space-12); }
  section h2 { margin-bottom: var(--space-4); }
  section p + p { margin-top: var(--space-2); }
  .bg-row { display: flex; gap: var(--space-4); align-items: baseline; }
  .bg-row + .bg-row { margin-top: var(--space-3); }
  .bg-label { width: 6rem; flex-shrink: 0; font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-text-subtle); }
  .bg-row ul { list-style: none; padding: 0; margin: 0; flex: 1; }
  .bg-row li + li { margin-top: var(--space-1); }
  /* Years sit flush right in their own column, like the dates on /projects/,
     so a long name wraps inside its cell instead of stranding the years. */
  .bg-row li { display: flex; justify-content: space-between; gap: var(--space-4); align-items: baseline; }
  .when { flex-shrink: 0; font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-text-subtle); }
  .name { color: var(--color-text); }
  .name:hover { color: var(--color-accent); }
  .recent { list-style: none; padding: 0; }
  .recent li + li { margin-top: var(--space-3); }
  .recent a { display: grid; grid-template-columns: 4rem 1fr; gap: var(--space-4); color: var(--color-text); align-items: baseline; }
  .recent a:hover .title { color: var(--color-accent); }
  .recent time { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-text-subtle); }
  .recent .title { transition: color var(--transition); }
  .more { margin-top: var(--space-6); font-size: var(--text-sm); }
  .more a { padding-block: var(--space-1); }
  @media (max-width: 600px) {
    .intro { grid-template-columns: 1fr; }
    .bg-row { flex-direction: column; gap: var(--space-1); }
    .bg-label { width: auto; }
  }
</style>
