---
// src/pages/writing/[...slug].astro
// Renders one writing entry. Posts with math: true also preload the two KaTeX fonts.
import BaseLayout from '../../layouts/BaseLayout.astro';
import LikeButton from '../../components/LikeButton.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
// KaTeX styles ship from our own origin: the import bundles the CSS (its
// fonts get hashed into /_astro/ with immutable caching), and the two
// preloads below cover the faces almost every formula uses.
import 'katex/dist/katex.min.css';
import katexMainUrl from 'katex/dist/fonts/KaTeX_Main-Regular.woff2?url';
import katexMathUrl from 'katex/dist/fonts/KaTeX_Math-Italic.woff2?url';

export async function getStaticPaths() {
  const posts = await getCollection('writing', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  );
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

type Props = { post: CollectionEntry<'writing'> };
const { post } = Astro.props;
const { Content } = await render(post);
const fmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<BaseLayout title={`${post.data.title} — Peter Massih`} description={post.data.description}>
  {post.data.math && (
    <Fragment slot="head">
      <link rel="preload" href={katexMainUrl} as="font" type="font/woff2" crossorigin />
      <link rel="preload" href={katexMathUrl} as="font" type="font/woff2" crossorigin />
    </Fragment>
  )}

  <main id="main" class="post">
  <article>
    <header>
      <div class="meta-row">
        <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{fmt.format(post.data.pubDate)}</time>
        <LikeButton slug={post.id} />
      </div>
      <h1>{post.data.title}</h1>
    </header>
    <div class="body">
      <Content />
    </div>
  </article>
  </main>
</BaseLayout>

<script>import '../../scripts/scrollable.js';</script>

<style>
  /* Prose, the notation table, and math keep the column of every other page
     (the content width minus main's padding), so they line up with the
     header; only code blocks and figures break out to --wide-width. */
  .post { max-width: var(--wide-width); }
  .post article > header,
  .body :global(p),
  .body :global(h2),
  .body :global(h3),
  .body :global(ul),
  .body :global(ol),
  .body :global(blockquote),
  .body :global(table),
  .body :global(.katex-display) {
    max-width: calc(var(--content-width) - 2 * var(--space-4));
    margin-inline: auto;
  }
  /* Long math posts leave tens of thousands of elements in the DOM. Blocks
     far offscreen skip style, layout, and paint until the reader approaches;
     the placeholder height keeps the scrollbar honest before first render. */
  .body > :global(*) {
    content-visibility: auto;
    contain-intrinsic-size: auto 10rem;
  }
  .post article > header { margin-bottom: var(--space-12); }
  .meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }
  time {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }
  .post h1 { font-size: var(--text-3xl); }
  /* In-page links (the contents line) never break inside a label. */
  .body :global(p a[href^='#']) { white-space: nowrap; }
  /* Proof folds stay closed by default so the argument reads without the
     machinery. Native details/summary preserves keyboard behavior. */
  .body :global(details.proof) {
    margin-top: var(--space-4);
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-border);
  }
  .body :global(details.proof summary) {
    cursor: pointer;
    padding: var(--space-2) 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    transition: color 150ms;
  }
  .body :global(details.proof summary:hover) { color: var(--color-text); }
  .body :global(details.proof[open] > summary) { color: var(--color-text); }
  /* Wide math and tables scroll inside their own box; the page never
     scrolls horizontally on narrow screens. */
  .body :global(.katex-display) {
    overflow-x: auto;
    overflow-y: hidden;
    padding: var(--space-1) 0;
  }
  .body :global(table) {
    display: block;
    overflow-x: auto;
    margin-top: var(--space-4);
    border-collapse: collapse;
    font-size: var(--text-sm);
  }
  .body :global(th), .body :global(td) {
    padding: var(--space-1) var(--space-3);
    border-bottom: 1px solid var(--color-border);
    text-align: left;
    font-variant-numeric: tabular-nums;
  }
  /* Number columns (---: in Markdown) align on their digits. */
  .body :global(:is(th, td)[align='right']) { text-align: right; }
  .body :global(figure.viz) { margin: var(--space-8) 0; overflow-x: auto; }
  .body :global(figure.viz img),
  .body :global(figure.viz svg) {
    width: 100%;
    height: auto;
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }
  .body :global(figure.viz figcaption) {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
  }
</style>
