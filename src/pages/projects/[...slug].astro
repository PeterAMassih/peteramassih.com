---
// src/pages/projects/[...slug].astro
// One project: the same facts as its list entry, then any detail from its Markdown body.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectItem from '../../components/ProjectItem.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

type Props = { project: CollectionEntry<'projects'> };
const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={`${project.data.title} — Peter Massih`} description={project.data.description}>
  <main id="main">
    <ProjectItem project={project} heading="h1">
      <div class="body">
        <Content />
      </div>
    </ProjectItem>
  </main>
</BaseLayout>
