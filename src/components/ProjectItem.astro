---
// src/components/ProjectItem.astro
// One project: name, dates and context, result line, links. /projects/ lists
// all six with heading="h2"; a project's own page renders it with
// heading="h1" (no self-link) and its Markdown body in the slot.
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  heading?: 'h1' | 'h2';
}
const { project, heading: Heading = 'h2' } = Astro.props;
const { title, description, pubDate, startDate, context, links } = project.data;
// Dates are stored as UTC midnight; formatting in UTC keeps the 1st of a
// month from rendering as the previous month in timezones west of Greenwich.
const fmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', timeZone: 'UTC' });
const month = (d: Date) => d.toISOString().slice(0, 7);
---

<article class="project">
  <Heading>
    {Heading === 'h1' ? title : <a href={`/projects/${project.id}/`}>{title}</a>}
  </Heading>
  <p class="meta">
    {startDate && <><time datetime={month(startDate)}>{fmt.format(startDate)}</time> – </>}
    <time datetime={month(pubDate)}>{fmt.format(pubDate)}</time> · {context}
  </p>
  <p class="result">{description}</p>
  <p class="links">
    {links.map((l, i) => <>{i > 0 && ' · '}<a href={l.href}>{l.label}</a></>)}
  </p>
  <slot />
</article>

<style>
  .project + .project { margin-top: var(--space-8); }
  h2 { font-size: var(--text-base); }
  h2 a { padding-block: var(--space-1); color: var(--color-text); }
  h2 a:hover { color: var(--color-accent); }
  .meta { margin-top: var(--space-1); font-size: var(--text-sm); color: var(--color-text-subtle); }
  .result { margin-top: var(--space-1); color: var(--color-text-muted); }
  .links { margin-top: var(--space-1); font-size: var(--text-sm); }
  .links a { padding-block: var(--space-1); }
</style>
