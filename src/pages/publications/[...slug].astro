---
// src/pages/publications/[...slug].astro
// Detail page for one publication. Renders the MDX body below the metadata
// header — body is optional, so empty MDX files still produce a clean page.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const pubs = await getCollection('publications');
  return pubs.map((pub) => ({ params: { slug: pub.id }, props: { pub } }));
}

type Props = { pub: CollectionEntry<'publications'> };
const { pub } = Astro.props;
const { Content } = await render(pub);
const fmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long' });
---

<BaseLayout title={`${pub.data.title} — Peter Massih`} description={pub.data.description}>
  <article class="pub">
    <header>
      <p class="meta">
        <time datetime={pub.data.pubDate.toISOString()}>{fmt.format(pub.data.pubDate)}</time>
      </p>
      <h1>{pub.data.title}</h1>
      <p class="authors">
        {pub.data.authors.map((a, i) => (
          <>
            {i > 0 && ', '}
            {a.startsWith('Peter') ? <strong>{a}</strong> : a}
          </>
        ))}
      </p>
      <p class="venue">
        {pub.data.venue}
        {pub.data.arxiv && <> · <a href={pub.data.arxiv} target="_blank" rel="noopener noreferrer">arXiv →</a></>}
        {pub.data.pdf && <> · <a href={pub.data.pdf} target="_blank" rel="noopener noreferrer">PDF →</a></>}
        {pub.data.code && <> · <a href={pub.data.code} target="_blank" rel="noopener noreferrer">Code →</a></>}
      </p>
    </header>
    <div class="body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .pub {
    max-width: var(--content-width);
    margin: var(--space-24) auto var(--space-16);
    padding: 0 var(--space-4);
  }
  .pub > header { margin-bottom: var(--space-12); }
  .meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
    margin-bottom: var(--space-4);
  }
  .pub h1 { line-height: 1.2; margin-bottom: var(--space-4); }
  .authors { color: var(--color-text-muted); font-size: var(--text-sm); margin-top: var(--space-3); }
  .venue { color: var(--color-text-subtle); font-family: var(--font-mono); font-size: var(--text-xs); margin-top: var(--space-2); }
  .venue a { color: var(--color-text-muted); }
  .venue a:hover { color: var(--color-text); }
  .body :global(p) { margin-top: var(--space-4); line-height: 1.7; }
  .body :global(h2) { margin-top: var(--space-8); margin-bottom: var(--space-3); }
  .body :global(h3) { margin-top: var(--space-6); margin-bottom: var(--space-2); }
</style>
