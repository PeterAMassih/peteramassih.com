---
// src/pages/writing/index.astro
// All posts, newest first, on the same date-column grid as the home page.
// Drafts are hidden in production builds.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing', ({ data }) =>
  import.meta.env.PROD ? !data.draft : true,
)).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const fmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<BaseLayout title="Writing — Peter Massih" description="Writing by Peter Massih, including a post on Mask2Former.">
  <main id="main">
    <h1>Writing</h1>
    <ul class="posts">
      {posts.map((post) => (
        <li>
          <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{fmt.format(post.data.pubDate)}</time>
          <a href={`/writing/${post.id}/`}>{post.data.title}</a>
          <p class="muted">{post.data.description}</p>
        </li>
      ))}
    </ul>
  </main>
</BaseLayout>

<style>
  .posts { list-style: none; padding: 0; }
  .posts li + li { margin-top: var(--space-6); }
  .posts li { display: grid; grid-template-columns: 7rem 1fr; column-gap: var(--space-4); align-items: baseline; }
  .posts time { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-text-subtle); }
  .posts a { font-weight: 600; color: var(--color-text); }
  .posts a:hover { color: var(--color-accent); }
  .posts p { grid-column: 2; margin-top: var(--space-1); }
  @media (max-width: 600px) {
    .posts li { grid-template-columns: 1fr; }
    .posts p { grid-column: 1; }
  }
</style>
